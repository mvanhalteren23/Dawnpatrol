# --- Core ---
# Local: `docker compose up -d db`. Production: your Neon / Supabase / Vercel Postgres URL.
DATABASE_URL="postgresql://dawnpatrol:dawnpatrol@localhost:5432/dawnpatrol"
# Same as DATABASE_URL unless your host gives you a separate pooled URL (then put the direct one here).
DIRECT_DATABASE_URL="postgresql://dawnpatrol:dawnpatrol@localhost:5432/dawnpatrol"
# Public URL — production: https://www.dawnpatrol-tech.com
APP_URL="http://localhost:3000"
# 32+ random chars. Signs session cookies and tracking links.
AUTH_SECRET="change-me-to-a-long-random-string"
# First admin (created by `npm run db:seed`)
ADMIN_EMAIL="you@dawnpatrol.co"
ADMIN_PASSWORD="change-me"
# Protects /api/cron/* (send as `Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET="change-me"

# --- Claude (research, prospecting, KB drafting, receptionist test chat) ---
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-sonnet-5-5
CLAUDE_MODEL=""

# --- ElevenLabs Conversational AI ---
ELEVENLABS_API_KEY=""
# Secret from ElevenLabs post-call webhook settings (HMAC)
ELEVENLABS_WEBHOOK_SECRET=""
# Optional: LLM id ElevenLabs should use for the agent (e.g. a Claude model id from their LLM list)
ELEVENLABS_LLM=""
ELEVENLABS_DEFAULT_VOICE_ID=""

# --- Twilio (demo line directory + SMS) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# The shared demo number callers dial before entering a prospect's extension (E.164)
TWILIO_DEMO_NUMBER="+17786504870"

# --- Google (Drive folder system + Gmail outreach tracking) ---
# OAuth client (Web application). Redirect URI: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Name of the top-level Drive folder the app creates (and owns) on first use.
GOOGLE_DRIVE_ROOT_NAME="Dawn Patrol Co — CRM"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Outreach webhook (Instantly / Lemlist / Zapier / Make) ---
OUTREACH_WEBHOOK_SECRET=""

# Gemini (aistudio.google.com → Get API key). Used for web research by default when set;
# choose models per job in CRM → Settings → AI models.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
