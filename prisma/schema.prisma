// AI receptionist agency CRM + client portal
// Postgres everywhere (local dev: `docker compose up -d db`; production: Neon/Supabase/
// Vercel Postgres). Enums are modelled as strings and JSON payloads as text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Pooled hosts (Neon, Supabase) need a direct connection for schema changes; defaults to DATABASE_URL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String
  role               String    @default("CLIENT") // ADMIN | REP | CLIENT
  disabled           Boolean   @default(false) // can't sign in (kept for history: their calls, emails, notes)
  failedLogins       Int       @default(0) // wrong passwords in a row; 10 locks the login for 15 minutes
  lockedUntil        DateTime?
  // Sessions signed in before this are signed out (set on password change/reset and on disabling).
  sessionsValidAfter DateTime?
  accountId          String? // set for CLIENT users (portal access)
  account            Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  google        GoogleAccount?
  ownedAccounts Account[]      @relation("AccountOwner")
  activities    Activity[]
  prompts       SavedPrompt[]
  imports       ImportJob[]
}

// ---------------------------------------------------------------------------
// CRM: accounts move from prospect -> paying client on one record
// ---------------------------------------------------------------------------

model Account {
  id                    String  @id @default(cuid())
  name                  String
  domain                String? @unique // normalised, used for de-duplication and email matching
  website               String?
  phone                 String?
  industry              String?
  city                  String?
  state                 String?
  employees             Int?
  // PROSPECT | CONTACTED | ENGAGED | DEMO | PROPOSAL | ONBOARDING | ACTIVE | PAST_DUE | CHURNED | LOST
  stage                 String  @default("PROSPECT")
  source                String  @default("manual") // manual | import | claude | inbound
  fitScore              Int? // 0-100, from Claude research or manual
  tags                  String  @default("") // comma separated
  notes                 String  @default("")
  estMissedCallsPerWeek Int?
  avgJobValueCents      Int?
  // Set when something created or changed this account automatically (e.g. a receptionist
  // booking); the CRM shows it until someone reviews it.
  needsReview           Boolean @default(false)
  reviewReason          String?

  ownerId String?
  owner   User?   @relation("AccountOwner", fields: [ownerId], references: [id])

  driveFolderId  String?
  driveFolderUrl String?

  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contacts      Contact[]
  activities    Activity[]
  research      ResearchRun[]
  subscription  Subscription?
  invoices      Invoice[]
  receptionists Receptionist[]
  driveFolders  DriveFolder[]
  emailDrafts   EmailDraft[]
  users         User[]
  callAudits    CallAudit[]

  @@index([stage])
}

model Contact {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  title     String?
  email     String?
  phone     String?
  linkedin  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  activities Activity[]

  @@index([email])
}

// Every touch — manual, synced from Gmail, pushed by a webhook, or system generated.
model Activity {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // EMAIL | CALL | SMS | LINKEDIN | MEETING | NOTE | TASK | STAGE_CHANGE | RESEARCH | BILLING
  type          String
  direction     String? // OUTBOUND | INBOUND
  subject       String?
  body          String?
  source        String    @default("manual") // manual | gmail | webhook | system | crm-send
  externalId    String?   @unique // gmail message id / webhook event id — idempotency
  threadId      String?
  openCount     Int       @default(0)
  firstOpenedAt DateTime?
  clickCount    Int       @default(0)
  repliedAt     DateTime?
  dueAt         DateTime? // tasks
  completedAt   DateTime?
  // Dialer calls
  outcome       String? // connected | booked | voicemail | no_answer | call_back | not_interested | wrong_number
  durationSec   Int?
  recordingSid  String?
  answeredBy    String? // Twilio answering-machine detection: human | machine_end_beep | … (auto-dialer)
  occurredAt    DateTime  @default(now())
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id])

  @@index([accountId, occurredAt])
  @@index([type, dueAt])
}

// ---------------------------------------------------------------------------
// Claude prospecting & research
// ---------------------------------------------------------------------------

model SavedPrompt {
  id          String   @id @default(cuid())
  name        String
  kind        String // RESEARCH | PROSPECTING | OUTREACH
  description String   @default("")
  template    String // supports {{variables}} — see src/lib/prompts.ts
  isDefault   Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs ResearchRun[]
}

model ResearchRun {
  id           String       @id @default(cuid())
  kind         String // RESEARCH | PROSPECTING | OUTREACH | KB_DRAFT
  accountId    String?
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  promptId     String?
  prompt       SavedPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  input        String
  output       String       @default("") // markdown
  resultJson   String? // structured extraction (JSON text)
  status       String       @default("RUNNING") // RUNNING | DONE | FAILED
  error        String?
  model        String?
  tokensIn     Int?
  tokensOut    Int?
  driveFileId  String?
  driveFileUrl String?
  createdAt    DateTime     @default(now())
  finishedAt   DateTime?
}

model ImportJob {
  id          String   @id @default(cuid())
  filename    String
  total       Int      @default(0)
  created     Int      @default(0)
  updated     Int      @default(0)
  skipped     Int      @default(0)
  errors      String   @default("[]")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Plan {
  id              String   @id @default(cuid())
  name            String   @unique
  priceCents      Int
  setupFeeCents   Int      @default(0)
  includedMinutes Int      @default(0)
  minimumMonths   Int      @default(0) // minimum contract term
  features        String   @default("") // newline separated
  stripePriceId   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  accountId            String    @unique
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id])
  status               String    @default("INCOMPLETE") // TRIALING | ACTIVE | PAST_DUE | CANCELED | INCOMPLETE
  mrrCents             Int       @default(0)
  billingMethod        String    @default("stripe") // stripe | manual
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  startedAt            DateTime?
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Invoice {
  id              String    @id @default(cuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stripeInvoiceId String?   @unique
  number          String?
  amountCents     Int
  status          String // DRAFT | OPEN | PAID | VOID | UNCOLLECTIBLE
  dueDate         DateTime?
  paidAt          DateTime?
  hostedUrl       String?
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// AI receptionist + RAG knowledge base
// ---------------------------------------------------------------------------

model Receptionist {
  id                    String         @id @default(cuid())
  accountId             String
  account               Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                  String         @default("Receptionist")
  businessName          String
  greeting              String         @default("")
  persona               String         @default("Warm, concise, professional.")
  voiceId               String?
  language              String         @default("en")
  timezone              String         @default("America/New_York")
  businessHours         String         @default("")
  escalationPhone       String?
  escalationRules       String         @default("")
  bookingUrl            String?
  extraInstructions     String         @default("")
  // ElevenLabs
  elevenLabsAgentId     String?        @unique // how a post-call webhook finds its receptionist
  elevenLabsKbDocs      String         @default("[]") // JSON [{category, docId}]
  ragToken              String         @unique // bearer secret for the ElevenLabs server-tool RAG endpoint
  // Demo line: callers to the shared demo number enter this extension to reach this agent.
  demoExtension         String?        @unique
  // "inbound" = answers calls (receptionist); "followup" = calls website leads back within minutes.
  agentType             String         @default("inbound")
  followupGoal          String         @default("") // e.g. "Book a site visit for a quote"
  followupQuestions     String         @default("") // one per line
  followupGuardrails    String         @default("") // the business's rules, one per line
  followupCallHours     String         @default("Mon-Fri 09:00-20:00\nSat-Sun 10:00-18:00")
  followupDelaySeconds  Int            @default(60) // wait before calling (0–240)
  followupMaxAttempts   Int            @default(2)
  followupTextIfMissed  Boolean        @default(true)
  leadFormKey           String?        @unique // public key in the website form's address
  leads                 Lead[]
  // Text the owner about new leads: "" (off) | messages (calls needing a call back) | leads (also
  // bookings and transfers), to these comma-separated numbers (blank = the ring-first cell).
  leadAlertOn           String         @default("")
  leadAlertTo           String         @default("")
  optOuts               SmsOptOut[]
  // Call reports for the client (totals only): "" (off) | weekly | monthly | both; sent to these
  // comma-separated emails (blank = the account's portal logins).
  reportFrequency       String         @default("")
  reportEmails          String         @default("")
  // Keeping the client's existing number: "" | forward_no_answer | forward_all | port.
  existingNumber        String?
  existingCarrier       String?
  keepNumberMethod      String         @default("")
  portStatus            String         @default("") // "" | gathering | submitted | scheduled | done
  portDate              DateTime?
  portNotes             String         @default("")
  reports               ClientReport[]
  // Whose Google Calendar/Gmail this receptionist books into and confirms from: a rep's own
  // connection (their demo receptionists), or null = the company Google connection.
  googleUserId          String?
  createdById           String?
  // Calendar booking (Google Calendar of the connected Google account; a client can share
  // their calendar with that account and put its address in bookingCalendarId).
  bookingEnabled        Boolean        @default(false)
  bookingCalendarId     String         @default("primary")
  bookingTitle          String         @default("Discovery call")
  bookingSlotMinutes    Int            @default(30)
  bookingHours          String         @default("Mon-Fri 09:00-17:00") // one line per rule, e.g. "Mon-Fri 09:00-12:00, 13:00-17:00"
  bookingMinNoticeHours Int            @default(2)
  bookingDaysAhead      Int            @default(14)
  bookingBufferMinutes  Int            @default(0)
  bookingMeetingType    String         @default("phone") // phone | google_meet | caller_choice
  bookingQuestions      String         @default("") // asked before booking, one per line; answers go on the event
  bookingHolidays       String         @default("") // "" | "CA-BC": no bookings on these statutory holidays
  bookingClosedDates    String         @default("") // extra closed days, YYYY-MM-DD, one per line
  // Summary sent to the caller after a call and/or a booking, by text or email.
  followUpOn            String         @default("") // "" (off) | bookings | calls | both
  followUpChannel       String         @default("caller_choice") // caller_choice | sms | email
  // Business line: a Twilio number that rings the owner's cell first, then hands unanswered
  // calls to the agent (src/app/api/voice/business). Texts to it are forwarded to the cell.
  businessNumber        String?        @unique // E.164
  businessNumberSid     String?
  ringFirstNumber       String? // owner's cell, E.164
  ringSeconds           Int            @default(20)
  ringMode              String         @default("hours") // always | hours (only during bookable hours) | never (straight to the agent)
  bookingAddsToCrm      Boolean        @default(false) // create/update a CRM lead for each booking (the agency's own receptionist)
  elevenLabsToolIds     String         @default("{}") // JSON {name: toolId} for the booking webhook tools
  syncStatus            String         @default("NEVER") // NEVER | SYNCED | DIRTY | FAILED
  syncError             String?
  lastSyncedAt          DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  knowledge KnowledgeItem[]
  calls     CallLog[]
  followUps FollowUpMessage[]
}

/**
 * A text or email the receptionist sent a caller after a call or booking.
 */
model FollowUpMessage {
  id             String       @id @default(cuid())
  receptionistId String
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  conversationId String? // ElevenLabs conversation, when known
  kind           String // booking | call | owner_alert
  channel        String // sms | email
  to             String
  subject        String?
  body           String
  status         String // SENT | FAILED | SKIPPED (caller opted out)
  error          String?
  createdAt      DateTime     @default(now())

  @@index([receptionistId, createdAt])
  @@index([conversationId])
}

model KnowledgeItem {
  id             String       @id @default(cuid())
  receptionistId String
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  // FAQ | SERVICE | PRICING | HOURS | LOCATION | POLICY | STAFF | SCRIPT | OTHER
  category       String       @default("FAQ")
  title          String
  content        String
  tags           String       @default("")
  isActive       Boolean      @default(true)
  updatedBy      String? // email of last editor (admin or client)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([receptionistId, category])
}

model CallLog {
  id             String       @id @default(cuid())
  receptionistId String
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  externalId     String       @unique // ElevenLabs conversation_id
  callerNumber   String?
  callerName     String?
  startedAt      DateTime
  durationSec    Int          @default(0)
  summary        String       @default("")
  transcript     String       @default("")
  // BOOKED | MESSAGE_TAKEN | ANSWERED | TRANSFERRED | MISSED_OPPORTUNITY | SPAM | UNKNOWN
  outcome        String       @default("UNKNOWN")
  followUpNeeded Boolean      @default(false)
  followedUpAt   DateTime?
  createdAt      DateTime     @default(now())

  @@index([receptionistId, startedAt])
}

// ---------------------------------------------------------------------------
// Google Drive folder system
// ---------------------------------------------------------------------------

model DriveFolder {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   String // ROOT | RESEARCH | OUTREACH | CONTRACTS | KNOWLEDGE_BASE | CALL_LOGS | BILLING
  driveId   String
  url       String
  createdAt DateTime @default(now())

  @@unique([accountId, purpose])
}

// Key/value store: Google OAuth refresh token, Gmail sync cursor, goals, top-level Drive folder ids.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * One model call made through the AI router (src/lib/ai), for cost and credit tracking.
 */
model AiUsage {
  id        String   @id @default(cuid())
  task      String // research | prospecting | kb_draft | extraction | outreach | caller_summary | test_chat
  provider  String // anthropic | gemini
  model     String
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  ok        Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([task, createdAt])
}

/**
 * An AI-drafted outreach email, with your rating/feedback and what was actually sent: the email writer learns from these.
 */
model EmailDraft {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId      String?
  promptId       String?
  instructions   String   @default("") // one-off instructions given for this draft
  subject        String
  body           String
  rating         Int? // 1 = good, -1 = bad
  feedback       String?
  sentSubject    String?
  sentBody       String?
  sentActivityId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

/**
 * Voicemails the dialer can leave: recorded by you (by phone or upload), or AI-written and voiced per account.
 */
model VoicemailAudio {
  id          String   @id @default(cuid())
  kind        String // recorded | upload | ai
  name        String
  mimeType    String   @default("audio/mpeg")
  data        Bytes
  script      String? // AI voicemails: what it says
  accountId   String? // AI voicemails are per account
  durationSec Int?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
}

/**
 * A person's own Google connection (Gmail sending + tracking, Calendar). The company connection lives in Setting.
 */
model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  refreshToken String // encrypted (AES-256-GCM, key from AUTH_SECRET)
  scopes       String    @default("")
  gmailCursor  Int? // unix seconds of the last Gmail sync
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/**
 * A weekly or monthly call report emailed to a client (one per receptionist per period).
 */
model ClientReport {
  id             String       @id @default(cuid())
  receptionistId String
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  periodKey      String // "week:2026-10-19" | "month:2026-10-01"
  sentTo         String
  totals         String // JSON ReportTotals
  error          String?
  createdAt      DateTime     @default(now())

  @@unique([receptionistId, periodKey])
}

/**
 * Callers who texted STOP to a client's line: never text them from it again (until START).
 */
model SmsOptOut {
  id             String       @id @default(cuid())
  receptionistId String
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  phone          String // E.164
  createdAt      DateTime     @default(now())

  @@unique([receptionistId, phone])
}

/**
 * Someone who filled in a client's website form, for the follow-up agent to call.
 */
model Lead {
  id             String       @id @default(cuid())
  receptionistId String
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  name           String?
  phone          String? // E.164
  email          String?
  message        String       @default("")
  details        String       @default("{}") // JSON: every field the form sent
  source         String       @default("form") // form | webhook | test
  consent        Boolean      @default(false) // ticked "OK to call me" (our form) or sent by a connected form
  // NEW | QUEUED | CALLING | RETRY | NO_ANSWER | CONNECTED | BOOKED | CALL_BACK | NOT_INTERESTED | DO_NOT_CALL | WRONG_NUMBER | SKIPPED | FAILED
  status         String       @default("NEW")
  statusNote     String       @default("")
  attempts       Int          @default(0)
  nextAttemptAt  DateTime?
  lastCallSid    String?
  conversationId String?      @unique
  summary        String       @default("")
  calledAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([receptionistId, createdAt])
}

// One-week call audit: we call the business's public number as customers would ("mystery
// shopper"), at different times of day, to learn how calls are handled (knowledge for the
// receptionist) and measure missed calls (the baseline report). Nothing changes on their side.
model CallAudit {
  id               String      @id @default(cuid())
  accountId        String
  account          Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // PLANNED | RUNNING | ANALYZING | DONE | CANCELLED | FAILED
  status           String      @default("PLANNED")
  targetNumber     String // E.164, the number their customers call
  businessName     String
  industry         String      @default("auto_repair")
  timezone         String      @default("America/Vancouver")
  shopHours        String      @default("Mon-Fri 08:00-17:30")
  callsPerDay      Int         @default(3)
  afterHoursCalls  Int         @default(3)
  customScenarios  String      @default("")
  callerIds        String      @default("") // numbers to call from, one per line; empty = the dialer number
  ownerConsent     String      @default("") // who agreed to the audit, and when
  // Baseline assumptions (edited per audit)
  callsPerWeek     Int         @default(90)
  avgJobValueCents Int         @default(45000)
  afterHoursShare  Float       @default(0.2)
  newCustomerShare Float       @default(0.35)
  bookingRate      Float       @default(0.5)
  startsAt         DateTime
  endsAt           DateTime
  report           String      @default("") // JSON: findings, recommendations, facts
  error            String?
  shareToken       String      @unique
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  calls            AuditCall[]

  @@index([status])
}

model AuditCall {
  id             String    @id @default(cuid())
  auditId        String
  audit          CallAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  window         String // "Opening rush", "Lunch", "Evening (closed)"…
  afterHours     Boolean   @default(false)
  scenarioKey    String
  callerName     String
  toNumber       String? // a test call to one of the team; null = the business's number
  // PLANNED | CALLING | ANSWERED | VOICEMAIL | NO_ANSWER | BUSY | FAILED | SKIPPED
  status         String    @default("PLANNED")
  note           String    @default("")
  fromNumber     String?
  callSid        String?   @unique
  answeredBy     String?
  calledAt       DateTime?
  answeredAt     DateTime?
  ringSeconds    Int?
  durationSec    Int?
  conversationId String?   @unique
  transcript     String    @default("")
  summary        String    @default("")
  analysis       String    @default("") // JSON (see audit-rules CallAnalysis + questions and facts)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([auditId, scheduledAt])
  @@index([status, scheduledAt])
}

// Website sample call recordings (ElevenLabs), generated once from the scripts in site-content.ts
// and kept until a script or voice changes (hash).
model SampleAudio {
  key       String   @id // "<trade>:<scenario>"
  hash      String
  mime      String   @default("audio/mpeg")
  data      Bytes
  createdAt DateTime @default(now())
}
